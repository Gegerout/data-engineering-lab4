<!-- Логи клиента zkCli. В консоль только ошибки, чтобы был виден результат команд. -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%msg%n</pattern></encoder>
  </appender>
  <root level="ERROR">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
